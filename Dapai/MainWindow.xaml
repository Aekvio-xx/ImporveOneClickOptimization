<Window x:Class="Dapai.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="打π优化" Icon="Apex_logo.ico"
        Width="1030" Height="728" MinWidth="470" MinHeight="430"
        Background="#EFF1F4" Foreground="#202124" FontFamily="Segoe UI, Microsoft YaHei UI"
        FontSize="14" WindowStartupLocation="CenterScreen" UseLayoutRounding="True"
        SizeChanged="WindowSizeChanged" Closing="WindowClosing">
    <Window.Resources>
        <SolidColorBrush x:Key="CardFill" Color="#FAFAFB"/>
        <SolidColorBrush x:Key="CardBorder" Color="#DCE0E5"/>
        <SolidColorBrush x:Key="HeaderFill" Color="#E9ECF0"/>
        <SolidColorBrush x:Key="MutedText" Color="#565D66"/>
        <SolidColorBrush x:Key="AccentFill" Color="#005FB8"/>
        <BooleanToVisibilityConverter x:Key="BooleanVisibility"/>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardFill}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="FluentIcon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="GroupHeader" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource HeaderFill}"/>
            <Setter Property="CornerRadius" Value="7,7,0,0"/>
            <Setter Property="Padding" Value="15,0"/>
            <Setter Property="Height" Value="38"/>
        </Style>
        <Style x:Key="SettingRow" TargetType="Grid">
            <Setter Property="Height" Value="48"/>
            <Setter Property="Margin" Value="15,0"/>
        </Style>
        <Style x:Key="Divider" TargetType="Border">
            <Setter Property="Background" Value="#E6E8EB"/>
            <Setter Property="Height" Value="1"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource AccentFill}"/>
            <Setter Property="Padding" Value="17,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}"
                                CornerRadius="5" Padding="{TemplateBinding Padding}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#196EC1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#064F95"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="#202124"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Surface" Property="Opacity" Value=".55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Switch" TargetType="ToggleButton">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="FocusRing" BorderThickness="1" CornerRadius="5"
                                BorderBrush="Transparent" Background="Transparent">
                            <Border x:Name="Track" Width="40" Height="22" CornerRadius="11"
                                    VerticalAlignment="Center" Background="#CED2D7">
                                <Ellipse x:Name="Thumb" Width="14" Height="14" Margin="4,0"
                                         Fill="White" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource AccentFill}"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="Opacity" Value=".86"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Thumb" Property="Width" Value="16"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FocusRing" Property="BorderBrush" Value="#202124"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Track" Property="Opacity" Value=".45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="LaunchRow">
            <Border Padding="14,9" MinHeight="67" BorderBrush="#E6E8EB" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="34"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid Width="34" Height="34" VerticalAlignment="Center">
                        <Border CornerRadius="7" Background="#E8EBEF"
                                Visibility="{Binding UsesPlaceholder, Converter={StaticResource BooleanVisibility}}">
                            <TextBlock Text="&#xF0E2;" Style="{StaticResource FluentIcon}"
                                       FontSize="17" Foreground="#565F69" HorizontalAlignment="Center"/>
                        </Border>
                        <Image Source="{Binding Icon}" Width="28" Height="28"/>
                    </Grid>
                    <StackPanel Grid.Column="1" Margin="10,0,7,0" VerticalAlignment="Center">
                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="启动项名称" ToolTip="编辑启动项名称"
                                 Padding="2,1" MinHeight="24" FontWeight="SemiBold" FontSize="14">
                            <TextBox.Style>
                                <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="BorderBrush" Value="#B8BEC6"/>
                                        </Trigger>
                                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                            <Setter Property="Background" Value="White"/>
                                            <Setter Property="BorderBrush" Value="{StaticResource AccentFill}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                        <TextBlock Text="{Binding FileLabel}" ToolTip="{Binding FileDescription}"
                                   Margin="3,1,0,0" TextTrimming="CharacterEllipsis"
                                   FontSize="12" Foreground="{StaticResource MutedText}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="↑" Width="27" Height="30" Padding="0" Margin="0,0,3,0"
                                Click="MoveLaunchItemUp" IsEnabled="{Binding CanMoveUp}" ToolTip="上移启动项"
                                AutomationProperties.Name="{Binding Name, StringFormat='上移启动项 {0}'}"/>
                        <Button Content="↓" Width="27" Height="30" Padding="0" Margin="0,0,9,0"
                                Click="MoveLaunchItemDown" IsEnabled="{Binding CanMoveDown}" ToolTip="下移启动项"
                                AutomationProperties.Name="{Binding Name, StringFormat='下移启动项 {0}'}"/>
                        <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding Enabled, Mode=TwoWay}"
                                      Margin="0,0,10,0" AutomationProperties.Name="{Binding Name, StringFormat='启用启动项 {0}'}"/>
                        <Button Content="浏览" Width="52" Height="30" Click="BrowseLaunchItem"
                                AutomationProperties.Name="{Binding Name, StringFormat='浏览 {0} 的可执行文件'}"/>
                        <Button Width="32" Height="30" Margin="7,0,0,0" Padding="0" Click="RemoveLaunchItem"
                                ToolTip="删除启动项" AutomationProperties.Name="{Binding Name, StringFormat='删除启动项 {0}'}">
                            <TextBlock Text="&#xE74D;" Style="{StaticResource FluentIcon}"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="30,23,30,26" MaxWidth="1240">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Text="游戏模式" FontSize="34" FontWeight="SemiBold" Margin="0,0,0,16"/>
            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xE7FC;" Style="{StaticResource FluentIcon}" FontSize="22"/>
                        <TextBlock x:Name="ModeStatus" Text="普通模式" Margin="11,0,0,0" FontSize="17"
                                   VerticalAlignment="Center" FontWeight="SemiBold"
                                   AutomationProperties.LiveSetting="Polite"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="一键优化" Height="35" MinWidth="98" Click="OptimizeClicked"
                                Style="{StaticResource PrimaryButton}"/>
                        <Button Content="一键恢复" Height="35" MinWidth="98" Margin="10,0,0,0" Click="RestoreClicked"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid x:Name="Sections" Grid.Row="2" Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="SettingsColumn" Width="54*"/>
                    <ColumnDefinition x:Name="GutterColumn" Width="20"/>
                    <ColumnDefinition x:Name="LaunchColumn" Width="46*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel x:Name="SettingsPanel">
                    <TextBlock Text="优化设置" Style="{StaticResource SectionTitle}" Height="38" Margin="0,0,0,8"/>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,11">
                        <StackPanel>
                            <Border Style="{StaticResource GroupHeader}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE765;" Style="{StaticResource FluentIcon}"/>
                                    <TextBlock Text="键盘与输入" Margin="10,0,0,0" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Grid Style="{StaticResource SettingRow}">
                                <TextBlock x:Name="WinLabel" Text="屏蔽 Win 键和 Ctrl+Esc" VerticalAlignment="Center"/>
                                <ToggleButton x:Name="BlockWin" Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                              AutomationProperties.LabeledBy="{Binding ElementName=WinLabel}" Click="SettingChanged"/>
                            </Grid>
                            <Border Style="{StaticResource Divider}"/>
                            <Grid Style="{StaticResource SettingRow}">
                                <TextBlock x:Name="AltLabel" Text="禁用 Alt+Shift" VerticalAlignment="Center"/>
                                <ToggleButton x:Name="BlockAlt" Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                              AutomationProperties.LabeledBy="{Binding ElementName=AltLabel}" Click="SettingChanged"/>
                            </Grid>
                            <Border Style="{StaticResource Divider}"/>
                            <Grid Style="{StaticResource SettingRow}">
                                <TextBlock x:Name="EnglishLabel" Text="强制前台英文输入" VerticalAlignment="Center"/>
                                <ToggleButton x:Name="ForceEnglish" Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                              AutomationProperties.LabeledBy="{Binding ElementName=EnglishLabel}" Click="SettingChanged"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,11">
                        <StackPanel>
                            <Border Style="{StaticResource GroupHeader}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7F4;" Style="{StaticResource FluentIcon}"/>
                                    <TextBlock Text="显示" Margin="10,0,0,0" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Grid Style="{StaticResource SettingRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="DisplayLabel" Text="切换显示模式" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <ToggleButton x:Name="ManageDisplay" Style="{StaticResource Switch}" Margin="0,0,10,0"
                                                  AutomationProperties.LabeledBy="{Binding ElementName=DisplayLabel}" Click="SettingChanged"/>
                                    <ComboBox x:Name="DisplayChoice" Width="132" Height="31" AutomationProperties.Name="显示模式"
                                              IsEnabled="{Binding IsChecked, ElementName=ManageDisplay}"
                                              SelectionChanged="SettingChanged"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Border Style="{StaticResource GroupHeader}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE767;" Style="{StaticResource FluentIcon}"/>
                                    <TextBlock Text="声音" Margin="10,0,0,0" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Grid Style="{StaticResource SettingRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="AudioLabel" Text="切换音频输出" TextTrimming="CharacterEllipsis" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <ToggleButton x:Name="SwitchAudio" Style="{StaticResource Switch}" Margin="0,0,10,0"
                                                  AutomationProperties.LabeledBy="{Binding ElementName=AudioLabel}" Click="SettingChanged"/>
                                    <ComboBox x:Name="AudioChoice" Width="146" Height="31"
                                              ToolTip="{Binding SelectedItem.Name, RelativeSource={RelativeSource Self}}"
                                              AutomationProperties.Name="音频输出设备"
                                              IsEnabled="{Binding IsChecked, ElementName=SwitchAudio}"
                                              SelectionChanged="AudioChanged">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Name}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <Button Width="31" Height="31" Margin="8,0,0,0" Padding="0"
                                            ToolTip="刷新音频设备" AutomationProperties.Name="刷新音频设备"
                                            IsEnabled="{Binding IsChecked, ElementName=SwitchAudio}" Click="RefreshAudioClicked">
                                        <TextBlock Text="&#xE72C;" Style="{StaticResource FluentIcon}"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="LaunchPanel" Grid.Column="2">
                    <Grid Height="38" Margin="0,0,0,8">
                        <TextBlock Text="快捷启动" Style="{StaticResource SectionTitle}"/>
                        <Button Content="＋ 新增" HorizontalAlignment="Right" VerticalAlignment="Center"
                                Height="31" MinWidth="77" Click="AddLaunchItem"/>
                    </Grid>
                    <Border Style="{StaticResource Card}" x:Name="LaunchCard">
                        <ItemsControl x:Name="LaunchList" ItemTemplate="{StaticResource LaunchRow}"/>
                    </Border>
                    <TextBlock x:Name="LaunchEmpty" Text="暂无启动项" Foreground="{StaticResource MutedText}" Margin="2,8,0,0"/>
                </StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</Window>
